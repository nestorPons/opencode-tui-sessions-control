# Maintainer: Nestor Pons
pkgname=sessions-control
pkgver=0.1.0
pkgrel=1
pkgdesc="TUI para auditar el tiempo y los tokens de tus sesiones de opencode"
arch=('x86_64' 'aarch64' 'armv7h' 'i686')
url="https://github.com/nestorPons/opencode-tui-sessions-control"
license=('custom')
depends=()
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$pkgname-$pkgver"
	export CGO_ENABLED=0
	go build -trimpath -ldflags "-s -w" -o "$pkgname" ./cmd/sessions-control
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 docs/spec.md "$pkgdir/usr/share/doc/$pkgname/spec.md"
	install -Dm644 docs/AGENTS.md "$pkgdir/usr/share/doc/$pkgname/AGENTS.md"
}
